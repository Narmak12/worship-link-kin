<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème affiché pendant le lancement natif (avant que Flutter ne dessine sa première frame). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Thème utilisé une fois que Flutter a pris le relais. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launchBackground</item>
    </style>
</resources>
